# Copy this file to .env (repo root) and fill in real values — .env is
# gitignored, this .env.example is not. Used by dbt_project/profiles.yml
# via env_var(); also handy to `source .env` before any Databricks CLI /
# bundle command that wants the same credentials.
#
# Never commit a real .env. Treat the token like a password.

# A SQL warehouse's host + HTTP path — NOT a cluster's. Databricks
# workspace UI: SQL Warehouses > (pick one) > Connection details.
DATABRICKS_HOST=adb-3020218199835395.15.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Personal access token: Databricks workspace UI > User Settings >
# Developer > Access tokens > Generate new token.
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your own schema — this is what keeps dbt pointed at YOUR sandbox and not
# someone else's. ra26_elt_ex_<your first name>, e.g. ra26_elt_ex_han.
DBT_SCHEMA=ra26_elt_ex_han
